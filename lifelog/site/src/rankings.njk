---
layout: base.njk
title: "Rankings — Brewer Research & Design"
description: "A catalog of things ranked."
pagination:
  data: collections.rankings
  size: 20
  alias: entries
permalink: "rankings/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

{# Page header #}
<section class="py-10">
  <h1 class="hero-headline" style="font-size: clamp(36px, 6vw, 72px); margin-bottom: 12px;">Rankings</h1>
  <p class="hero-subtitle" style="margin-bottom: 0;">Definitive, non-negotiable orderings of things that matter.</p>
</section>

<div class="section-divider"></div>

{# Filter bar #}
<section class="flex flex-col md:flex-row items-stretch md:items-center gap-3 py-4 mb-2">
  <div class="flex-1 relative">
    <input
      type="text"
      id="section-filter"
      placeholder="Search rankings..."
      class="w-full bg-transparent border border-border rounded-lg px-4 py-2 text-sm outline-none focus:border-ink placeholder:text-ink-secondary"
      style="font-family: var(--font-body);"
      aria-label="Filter rankings by title or tag"
    >
  </div>
  <div class="flex flex-wrap gap-2">
    <div class="filter-dropdown relative">
      <button class="chip cursor-pointer" data-dropdown="sort">
        Sort <span class="text-ink-secondary">↓</span>
      </button>
      <div class="filter-dropdown__menu hidden" data-menu="sort">
        <button class="filter-dropdown__item" data-sort="newest">Newest First</button>
        <button class="filter-dropdown__item" data-sort="oldest">Oldest First</button>
        <button class="filter-dropdown__item" data-sort="id-asc">ID Ascending</button>
        <button class="filter-dropdown__item" data-sort="id-desc">ID Descending</button>
      </div>
    </div>
    <div class="filter-dropdown relative">
      <button class="chip cursor-pointer" data-dropdown="year">
        Year <span class="text-ink-secondary">↓</span>
      </button>
      <div class="filter-dropdown__menu hidden" data-menu="year">
        <button class="filter-dropdown__item is-active" data-year="">All Years</button>
        {%- set years = [] -%}
        {%- for entry in collections.rankings -%}
          {%- set yr = entry.data.date | dateFormat | truncate(4, true, '') -%}
          {%- if yr and yr not in years -%}
            {%- set years = (years.push(yr), years) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for yr in years | sort | reverse -%}
        <button class="filter-dropdown__item" data-year="{{ yr }}">{{ yr }}</button>
        {%- endfor -%}
      </div>
    </div>
    <div class="filter-dropdown relative">
      <button class="chip cursor-pointer" data-dropdown="tag">
        Tag <span class="text-ink-secondary">↓</span>
      </button>
      <div class="filter-dropdown__menu hidden" data-menu="tag">
        <button class="filter-dropdown__item is-active" data-filter-tag="">All Tags</button>
        {%- set allTags = [] -%}
        {%- for entry in collections.rankings -%}
          {%- for tag in entry.data.tags -%}
            {%- if tag !== "rankings" and tag not in allTags -%}
              {%- set allTags = (allTags.push(tag), allTags) -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- for tag in allTags | sort -%}
        <button class="filter-dropdown__item" data-filter-tag="{{ tag }}">{{ tag }}</button>
        {%- endfor -%}
      </div>
    </div>
    <div class="filter-dropdown relative">
      <button class="chip cursor-pointer" data-dropdown="category">
        Category <span class="text-ink-secondary">↓</span>
      </button>
      <div class="filter-dropdown__menu hidden" data-menu="category">
        <button class="filter-dropdown__item is-active" data-filter-cat="">All Categories</button>
        {%- set allCats = [] -%}
        {%- for entry in collections.rankings -%}
          {%- if entry.data.category and entry.data.category not in allCats -%}
            {%- set allCats = (allCats.push(entry.data.category), allCats) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for cat in allCats | sort -%}
        <button class="filter-dropdown__item" data-filter-cat="{{ cat | lower }}">{{ cat }}</button>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{# Entry list #}
<div class="entry-list" id="entry-table">
  {% for entry in entries %}
  {% if entry.data.status === "redacted" or entry.data.status === "withdrawn" %}
  <div
    class="entry-card entry-row entry-row--redacted"
    data-title=""
    data-tags=""
    data-category=""
    data-year="{{ entry.data.date | dateFormat | truncate(4, true, '') }}"
    data-date="{{ entry.data.date | dateFormat }}"
    data-id="{{ entry.data.catalogId.id }}"
    style="opacity: 0.5;"
  >
    <div class="entry-card__meta">
      <span class="entry-card__type type-rnk">{{ entry.data.catalogId.id }}</span>
    </div>
    <h3 class="entry-card__title" style="background: var(--color-ink); color: transparent; border-radius: 4px; display: inline-block;">&nbsp;&nbsp;REDACTED&nbsp;&nbsp;</h3>
  </div>
  {% else %}
  <a
    href="/rankings/{{ entry.data.catalogId.id | lower }}/"
    class="entry-card no-underline entry-row"
    data-title="{{ entry.data.title | lower }}"
    data-tags="{{ entry.data.tags | join(' ') | lower }}"
    data-category="{{ entry.data.category | lower }}"
    data-year="{{ entry.data.date | dateFormat | truncate(4, true, '') }}"
    data-date="{{ entry.data.date | dateFormat }}"
    data-id="{{ entry.data.catalogId.id }}"
  >
    <div class="entry-card__meta">
      <span class="entry-card__type type-rnk">{{ entry.data.catalogId.id }}</span>
      <span class="entry-card__date">{{ entry.data.date | dateFormat }}</span>
      {% for tag in entry.data.tags %}
        {% if tag !== "rankings" %}
        <span class="text-ink-secondary" style="font-size: 13px;">#{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
    <h3 class="entry-card__title">{{ entry.data.title }}</h3>
  </a>
  {% endif %}
  {% endfor %}

  {# Empty state #}
  {% if entries.length == 0 %}
  <div class="py-10 text-center text-ink-secondary">
    No entries found.
  </div>
  {% endif %}

  {# No results from filter #}
  <div id="no-filter-results" class="py-10 text-center text-ink-secondary hidden">
    No entries match the current filter.
  </div>
</div>

{# Pagination #}
{% if pagination.pages.length > 1 %}
<nav class="flex items-center justify-center gap-4 py-8" aria-label="Pagination">
  {% if pagination.href.previous %}
  <a href="{{ pagination.href.previous }}" class="chip no-underline">← Prev</a>
  {% else %}
  <span class="chip" style="opacity: 0.4;">← Prev</span>
  {% endif %}
  <span class="text-ink-secondary text-sm">Page {{ pagination.pageNumber + 1 }} / {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}
  <a href="{{ pagination.href.next }}" class="chip no-underline">Next →</a>
  {% else %}
  <span class="chip" style="opacity: 0.4;">Next →</span>
  {% endif %}
</nav>
{% endif %}

{# Client-side filter + sort + dropdown script #}
<script>
(function() {
  var input = document.getElementById('section-filter');
  var table = document.getElementById('entry-table');
  var rows = Array.from(document.querySelectorAll('.entry-row'));
  var noResults = document.getElementById('no-filter-results');

  var state = { text: '', year: '', tag: '', category: '', sort: 'id-desc' };

  // Dropdown toggle
  document.querySelectorAll('[data-dropdown]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var key = btn.getAttribute('data-dropdown');
      var menu = document.querySelector('[data-menu="' + key + '"]');
      var wasOpen = !menu.classList.contains('hidden');
      closeAllMenus();
      if (!wasOpen) menu.classList.remove('hidden');
    });
  });

  document.addEventListener('click', closeAllMenus);

  function closeAllMenus() {
    document.querySelectorAll('.filter-dropdown__menu').forEach(function(m) {
      m.classList.add('hidden');
    });
  }

  // Sort items
  document.querySelectorAll('[data-sort]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      state.sort = btn.getAttribute('data-sort');
      setActive(btn, 'sort');
      applyFilters();
    });
  });

  // Year filter
  document.querySelectorAll('[data-year]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      state.year = btn.getAttribute('data-year');
      setActive(btn, 'year');
      applyFilters();
    });
  });

  // Tag filter
  document.querySelectorAll('[data-filter-tag]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      state.tag = btn.getAttribute('data-filter-tag');
      setActive(btn, 'tag');
      applyFilters();
    });
  });

  // Category filter
  document.querySelectorAll('[data-filter-cat]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      state.category = btn.getAttribute('data-filter-cat');
      setActive(btn, 'category');
      applyFilters();
    });
  });

  // Text filter
  if (input) {
    input.addEventListener('input', function() {
      state.text = this.value.toLowerCase().trim();
      applyFilters();
    });
  }

  function setActive(btn, menuKey) {
    var menu = document.querySelector('[data-menu="' + menuKey + '"]');
    menu.querySelectorAll('.filter-dropdown__item').forEach(function(item) {
      item.classList.remove('is-active');
    });
    btn.classList.add('is-active');
    var trigger = document.querySelector('[data-dropdown="' + menuKey + '"]');
    var label = menuKey.charAt(0).toUpperCase() + menuKey.slice(1);
    var val = btn.textContent.trim();
    if (val.indexOf('All') === 0) {
      trigger.innerHTML = label + ' <span class="text-ink-secondary">↓</span>';
    } else {
      trigger.innerHTML = label + ': ' + val + ' <span class="text-ink-secondary">↓</span>';
    }
  }

  function applyFilters() {
    var visible = 0;
    var hasFilters = state.text || state.year || state.tag || state.category;

    rows.forEach(function(row) {
      var title = row.getAttribute('data-title') || '';
      var tags = row.getAttribute('data-tags') || '';
      var category = row.getAttribute('data-category') || '';
      var year = row.getAttribute('data-year') || '';
      var isRedacted = row.classList.contains('entry-row--redacted');

      var match = true;
      if (state.text && !isRedacted) {
        match = title.indexOf(state.text) !== -1 || tags.indexOf(state.text) !== -1;
      } else if (state.text && isRedacted) {
        match = false;
      }
      if (match && state.year) match = year === state.year;
      if (match && state.tag) match = tags.indexOf(state.tag) !== -1;
      if (match && state.category) match = category === state.category;

      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    // Sort visible rows
    var sorted = rows.slice().sort(function(a, b) {
      switch (state.sort) {
        case 'newest':
          return (b.getAttribute('data-date') || '').localeCompare(a.getAttribute('data-date') || '');
        case 'oldest':
          return (a.getAttribute('data-date') || '').localeCompare(b.getAttribute('data-date') || '');
        case 'id-asc':
          return (a.getAttribute('data-id') || '').localeCompare(b.getAttribute('data-id') || '');
        case 'id-desc':
        default:
          return (b.getAttribute('data-id') || '').localeCompare(a.getAttribute('data-id') || '');
      }
    });

    sorted.forEach(function(row) {
      table.insertBefore(row, noResults);
    });

    noResults.style.display = visible === 0 && hasFilters ? '' : 'none';
    noResults.classList.toggle('hidden', visible > 0 || !hasFilters);
  }
})();
</script>
