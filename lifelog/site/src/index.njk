---
layout: base.njk
title: "Brewer Research & Design"
description: "A personal archive of rankings, writing, and projects."
---

{# Hero #}
<section class="hero">
  <h1 class="hero-headline">
    An archive of things<br>
    <em>ranked, written,</em><br>
    and made.
  </h1>
  <p class="hero-subtitle">
    A personal research archive by Quinn Brewer. Documenting the mundane with institutional seriousness since 2026.
  </p>
  <a href="/rankings/" class="pill-button">Start reading &rarr;</a>
</section>

<div class="section-divider"></div>

{# Trending / Recent section #}
<section class="py-10">
  <div class="section-header mb-6">
    <h2 class="section-title">Recent entries</h2>
  </div>

  {%- set sortedEntries = collections.allEntries | sort(true, false, 'data.date') -%}

  <div class="entry-list">
    {%- for entry in sortedEntries -%}
    {%- if loop.index0 < 8 -%}
    <a href="{{ entry.url }}" class="entry-card no-underline">
      <div class="entry-card__meta">
        <span class="entry-card__type
          {%- if entry.data.catalogId.id.startsWith('RNK') %} type-rnk
          {%- elif entry.data.catalogId.id.startsWith('WRT') %} type-wrt
          {%- elif entry.data.catalogId.id.startsWith('PRJ') %} type-prj
          {%- endif %}">{{ entry.data.catalogId.id | replace("-", "-") }}</span>
        <span class="entry-card__date">{{ (entry.data.date or entry.data.date_updated) | dateFormat }}</span>
      </div>
      <h3 class="entry-card__title">{{ entry.data.title }}</h3>
    </a>
    {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<div class="section-divider"></div>

{# Browse by section #}
<section class="py-10">
  <div class="section-header mb-8">
    <h2 class="section-title">Browse by section</h2>
  </div>

  <div class="browse-grid">
    <a href="/rankings/" class="browse-card no-underline">
      <span class="browse-card__count">{{ collections.rankings.length }}</span>
      <h3 class="browse-card__title">Rankings</h3>
      <p class="browse-card__desc">Definitive, non-negotiable orderings of things that matter.</p>
    </a>
    <a href="/writing/" class="browse-card no-underline">
      <span class="browse-card__count">{{ collections.writing.length }}</span>
      <h3 class="browse-card__title">Writing</h3>
      <p class="browse-card__desc">Essays, observations, and investigations of varying seriousness.</p>
    </a>
    <a href="/projects/" class="browse-card no-underline">
      <span class="browse-card__count">{{ collections.projects.length }}</span>
      <h3 class="browse-card__title">Projects</h3>
      <p class="browse-card__desc">Ongoing and completed works of questionable practical value.</p>
    </a>
  </div>
</section>
