---
permalink: "test/"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brewer Research & Design — Test</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    /* ===== MEDIUM-INSPIRED DESIGN TOKENS ===== */
    :root {
      --color-bg: #f7f4ed;
      --color-white: #ffffff;
      --color-black: #191919;
      --color-ink: #242424;
      --color-text: #333333;
      --color-muted: #6b6b6b;
      --color-green: #0aab4d;
      --color-rust: #e45033;
      --color-blue: #243f8c;
      --color-yellow: #fccb2d;

      --font-display: 'GT Super Display', Georgia, serif;
      --font-body: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      --font-mono: 'Departure Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;

      --radius-pill: 1386px;
      --spacing-unit: 8px;
    }

    html.dark {
      --color-bg: #1b1d17;
      --color-white: #22241e;
      --color-black: #F5F2EC;
      --color-ink: #e8e4dc;
      --color-text: #ccc8c0;
      --color-muted: #9a9590;
      --color-green: #3dda76;
      --color-rust: #f06a50;
      --color-blue: #5b7ee6;
      --color-yellow: #fccb2d;
    }

    /* ===== FONT FACES ===== */
    @font-face {
      font-family: "GT Super Display";
      src: url("/assets/fonts/GTSuperDisplay-Light.woff2") format("woff2");
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "GT Super Display";
      src: url("/assets/fonts/GTSuperDisplay-LightItalic.woff2") format("woff2");
      font-weight: 300;
      font-style: italic;
      font-display: swap;
    }
    @font-face {
      font-family: "GT Super Display";
      src: url("/assets/fonts/GTSuperDisplay-Bold.woff2") format("woff2");
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "GT Super Display";
      src: url("/assets/fonts/GTSuperDisplay-BoldItalic.woff2") format("woff2");
      font-weight: 700;
      font-style: italic;
      font-display: swap;
    }
    @font-face {
      font-family: "GT Super Display";
      src: url("/assets/fonts/GTSuperDisplay-SuperItalic.woff2") format("woff2");
      font-weight: 900;
      font-style: italic;
      font-display: swap;
    }
    @font-face {
      font-family: "Departure Mono";
      src: url("/assets/fonts/DepartureMono-Regular.woff2") format("woff2");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    /* ===== RESET & BASE ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.5;
      color: var(--color-text);
      background-color: var(--color-bg);
      transition: background-color 200ms, color 200ms;
    }

    ::selection {
      background-color: var(--color-black);
      color: var(--color-bg);
    }

    a { color: inherit; }

    /* ===== LAYOUT ===== */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .container--narrow {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ===== HEADER ===== */
    .header {
      border-bottom: 1px solid var(--color-text);
      background-color: var(--color-bg);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header__inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
    }

    .header__logo {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 400;
      letter-spacing: -0.02em;
      color: var(--color-black);
      text-decoration: none;
    }

    .header__nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .header__link {
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--color-ink);
      text-decoration: none;
      transition: color 150ms;
    }

    .header__link:hover {
      color: var(--color-black);
    }

    .header__theme-toggle {
      font-size: 16px;
      background: none;
      border: 1px solid var(--color-text);
      border-radius: var(--radius-pill);
      width: 36px;
      height: 36px;
      cursor: pointer;
      color: var(--color-ink);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 150ms;
    }

    .header__theme-toggle:hover {
      background-color: var(--color-black);
      color: var(--color-bg);
    }

    /* ===== HERO ===== */
    .hero {
      padding: 96px 0 80px;
      border-bottom: 1px solid var(--color-text);
    }

    .hero__headline {
      font-family: var(--font-display);
      font-size: clamp(48px, 8vw, 96px);
      font-weight: 300;
      line-height: 0.95;
      letter-spacing: -0.04em;
      color: var(--color-black);
      margin-bottom: 32px;
    }

    .hero__headline em {
      font-weight: 300;
      font-style: italic;
    }

    .hero__subtitle {
      font-family: var(--font-body);
      font-size: 20px;
      line-height: 1.5;
      color: var(--color-muted);
      max-width: 540px;
      margin-bottom: 40px;
    }

    .hero__cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
      color: var(--color-bg);
      background-color: var(--color-black);
      border: none;
      border-radius: var(--radius-pill);
      padding: 10px 24px;
      text-decoration: none;
      cursor: pointer;
      transition: opacity 150ms;
    }

    .hero__cta:hover {
      opacity: 0.85;
    }

    /* ===== SECTIONS ===== */
    .section {
      padding: 64px 0;
    }

    .section + .section {
      border-top: 1px solid rgba(0,0,0,0.08);
    }

    html.dark .section + .section {
      border-top-color: rgba(255,255,255,0.08);
    }

    .section__label {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin-bottom: 24px;
    }

    .section__title {
      font-family: var(--font-display);
      font-size: 32px;
      font-weight: 400;
      letter-spacing: -0.02em;
      color: var(--color-black);
      margin-bottom: 40px;
    }

    /* ===== ENTRY CARDS ===== */
    .entries {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .entry-card {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 24px;
      align-items: start;
      padding: 24px 0;
      border-bottom: 1px solid rgba(0,0,0,0.08);
      text-decoration: none;
      color: inherit;
      transition: opacity 150ms;
    }

    html.dark .entry-card {
      border-bottom-color: rgba(255,255,255,0.08);
    }

    .entry-card:first-child {
      padding-top: 0;
    }

    .entry-card:hover {
      opacity: 0.7;
    }

    .entry-card__meta {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .entry-card__title {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--color-black);
      line-height: 1.3;
      margin-bottom: 6px;
    }

    .entry-card__excerpt {
      font-size: 15px;
      line-height: 1.5;
      color: var(--color-muted);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .entry-card__tag {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      white-space: nowrap;
      align-self: center;
    }

    .entry-card__tag--rnk {
      background-color: var(--color-yellow);
      color: #191919;
    }

    .entry-card__tag--wrt {
      background-color: var(--color-blue);
      color: #f7f4ed;
    }

    .entry-card__tag--prj {
      background-color: var(--color-rust);
      color: #f7f4ed;
    }

    .entry-card__status {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-green);
    }

    /* ===== THREE-COLUMN GRID ===== */
    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
    }

    @media (max-width: 768px) {
      .grid-3 {
        grid-template-columns: 1fr;
        gap: 48px;
      }
    }

    .grid-3__col-label {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-muted);
      padding-bottom: 12px;
      border-bottom: 2px solid var(--color-black);
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
    }

    .grid-3__col-label span:last-child {
      color: var(--color-text);
    }

    .grid-3__item {
      display: block;
      padding: 12px 0;
      border-bottom: 1px solid rgba(0,0,0,0.08);
      text-decoration: none;
      color: inherit;
      transition: opacity 150ms;
    }

    html.dark .grid-3__item {
      border-bottom-color: rgba(255,255,255,0.08);
    }

    .grid-3__item:hover {
      opacity: 0.7;
    }

    .grid-3__item-id {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .grid-3__item-title {
      font-family: var(--font-display);
      font-size: 17px;
      font-weight: 700;
      color: var(--color-black);
      margin-top: 2px;
      line-height: 1.3;
    }

    .grid-3__view-all {
      display: inline-block;
      margin-top: 16px;
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--color-muted);
      text-decoration: none;
      transition: color 150ms;
    }

    .grid-3__view-all:hover {
      color: var(--color-black);
    }

    /* ===== FOOTER ===== */
    .footer {
      border-top: 1px solid var(--color-text);
      padding: 32px 0 48px;
      background-color: var(--color-bg);
    }

    .footer__inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer__text {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .footer__links {
      display: flex;
      gap: 20px;
    }

    .footer__link {
      font-size: 13px;
      color: var(--color-muted);
      text-decoration: none;
      transition: color 150ms;
    }

    .footer__link:hover {
      color: var(--color-black);
    }

    /* ===== MOBILE ===== */
    @media (max-width: 768px) {
      .hero { padding: 64px 0 48px; }
      .hero__headline { font-size: 48px; }
      .section { padding: 48px 0; }
      .header__nav { gap: 16px; }
      .header__link { display: none; }
      .entry-card { grid-template-columns: 1fr; gap: 8px; }
      .entry-card__tag { justify-self: start; }
      .footer__inner { flex-direction: column; gap: 16px; align-items: flex-start; }
    }
  </style>
  <script>
    (function(){var d=document.documentElement,t=localStorage.getItem('theme');if(t==='dark'||(t!=='light'&&window.matchMedia('(prefers-color-scheme:dark)').matches)){d.classList.add('dark')}})();
  </script>
</head>
<body>

  <!-- HEADER -->
  <header class="header">
    <div class="container">
      <div class="header__inner">
        <a href="/test/" class="header__logo">Brewer Research & Design</a>
        <div class="header__nav">
          <a href="/rankings/" class="header__link">Rankings</a>
          <a href="/writing/" class="header__link">Writing</a>
          <a href="/projects/" class="header__link">Projects</a>
          <a href="/about/" class="header__link">About</a>
          <button id="theme-toggle" class="header__theme-toggle" aria-label="Toggle dark mode">
            <span id="theme-icon">☾</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1 class="hero__headline">An archive of things<br><em>ranked, written,</em><br>and made.</h1>
      <p class="hero__subtitle">A personal research archive by Quinn Brewer. Documenting the mundane with institutional seriousness since 2026.</p>
      <a href="/rankings/" class="hero__cta">Start reading →</a>
    </div>
  </section>

  <!-- THREE-COLUMN INDEX -->
  <section class="section">
    <div class="container">
      <div class="grid-3">

        <!-- Rankings -->
        <div>
          <div class="grid-3__col-label">
            <span>Rankings</span>
            <span>{{ collections.rankings.length }}</span>
          </div>
          {% for entry in collections.rankings %}
          {% if loop.index0 < 5 %}
          <a href="/rankings/{{ entry.data.catalogId.id | lower }}/" class="grid-3__item">
            <div class="grid-3__item-id">{{ entry.data.catalogId.id }}</div>
            <div class="grid-3__item-title">{{ entry.data.title }}</div>
          </a>
          {% endif %}
          {% endfor %}
          <a href="/rankings/" class="grid-3__view-all">View all →</a>
        </div>

        <!-- Writing -->
        <div>
          <div class="grid-3__col-label">
            <span>Writing</span>
            <span>{{ collections.writing.length }}</span>
          </div>
          {% for entry in collections.writing %}
          {% if loop.index0 < 5 %}
          <a href="/writing/{{ entry.data.catalogId.id | lower }}/" class="grid-3__item">
            <div class="grid-3__item-id">{{ entry.data.catalogId.id }}</div>
            <div class="grid-3__item-title">{{ entry.data.title }}</div>
          </a>
          {% endif %}
          {% endfor %}
          <a href="/writing/" class="grid-3__view-all">View all →</a>
        </div>

        <!-- Projects -->
        <div>
          <div class="grid-3__col-label">
            <span>Projects</span>
            <span>{{ collections.projects.length }}</span>
          </div>
          {% for entry in collections.projects %}
          {% if loop.index0 < 5 %}
          <a href="/projects/{{ entry.data.catalogId.id | lower }}/" class="grid-3__item">
            <div class="grid-3__item-id">
              {{ entry.data.catalogId.id }}
              {% if entry.data.status %}
              <span class="entry-card__status" style="margin-left: 8px;">{{ entry.data.status }}</span>
              {% endif %}
            </div>
            <div class="grid-3__item-title">{{ entry.data.title }}</div>
          </a>
          {% endif %}
          {% endfor %}
          <a href="/projects/" class="grid-3__view-all">View all →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- RECENT ENTRIES (Feed) -->
  <section class="section">
    <div class="container--narrow">
      <div class="section__label">Recent</div>
      <div class="entries">
        {%- set sortedEntries = collections.allEntries | sort(true, false, 'data.date') -%}
        {%- for entry in sortedEntries -%}
        {%- if loop.index0 < 6 -%}
        <a href="{{ entry.url }}" class="entry-card">
          <div>
            <div class="entry-card__meta">
              <span>{{ entry.data.catalogId.id }}</span>
              <span>{{ (entry.data.date or entry.data.date_updated) | dateFormat }}</span>
            </div>
            <div class="entry-card__title">{{ entry.data.title }}</div>
            <div class="entry-card__excerpt">{{ entry.templateContent | excerpt }}</div>
          </div>
          {% set prefix = entry.data.catalogId.id.substring(0, 3) %}
          <div class="entry-card__tag entry-card__tag--{{ prefix | lower }}">{{ prefix }}</div>
        </a>
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer__inner">
        <div class="footer__text">Est. 2026 · Brewer Research & Design</div>
        <nav class="footer__links">
          <a href="/" class="footer__link">Current Home</a>
          <a href="/logs/" class="footer__link">Logs</a>
          <a href="/about/" class="footer__link">About</a>
          <a href="/encrypted/" class="footer__link">Encrypted</a>
        </nav>
      </div>
    </div>
  </footer>

  <script>
  (function () {
    var themeBtn = document.getElementById('theme-toggle');
    var themeIcon = document.getElementById('theme-icon');
    if (!themeBtn) return;
    function updateIcon() {
      var isDark = document.documentElement.classList.contains('dark');
      themeIcon.textContent = isDark ? '☀' : '☾';
    }
    updateIcon();
    themeBtn.addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcon();
    });
  })();
  </script>

</body>
</html>
