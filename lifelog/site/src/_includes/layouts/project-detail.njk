<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Brewer Research & Design</title>
  <meta name="description" content="{{ title }}">
  {% include "partials/head-meta.njk" %}
  <link rel="stylesheet" href="/assets/css/main.css">
  <script>
    (function(){var d=document.documentElement,t=localStorage.getItem('theme');if(t==='dark'||(t!=='light'&&window.matchMedia('(prefers-color-scheme:dark)').matches)){d.classList.add('dark')}})();
  </script>
</head>
<body>

  {% include "partials/header.njk" %}

  <main class="container py-6" style="background-color: var(--color-bg);">

    {# Breadcrumb #}
    <nav class="mb-6 flex items-center gap-2" style="font-size: 14px;" aria-label="Breadcrumb">
      <a href="/" class="text-ink-secondary no-underline hover:text-ink">Home</a>
      <span class="text-ink-secondary">/</span>
      <a href="/projects/" class="text-ink-secondary no-underline hover:text-ink">Projects</a>
      <span class="text-ink-secondary">/</span>
      <span class="text-ink font-bold">{{ catalogId.id }}</span>
    </nav>

    {# Title #}
    <h1 class="headline-lg m-0 mb-4" style="font-size: clamp(28px, 4vw, 42px);">{{ title }}</h1>

    {# Metadata row #}
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="entry-card__type type-prj">{{ catalogId.id }}</span>
      <span class="text-ink-secondary" style="font-size: 14px;">{{ date_started | dateFormat }} → {{ date_updated | dateFormat }}</span>
      {% if status %}
      <span class="chip {% if status === 'ongoing' %}chip-green{% elif status === 'abandoned' %}chip-rust{% endif %}">{{ status }}</span>
      {% endif %}
    </div>

    {# Links #}
    {% if links and links.length %}
    <div class="flex flex-wrap gap-3 mb-8">
      {% for link in links %}
      <a href="{{ link.url }}" class="pill-button no-underline" style="font-size: 14px; padding: 6px 20px;" target="_blank" rel="noopener">{{ link.label }} →</a>
      {% endfor %}
    </div>
    {% endif %}

    {# Entry body — project variant with dated log entries #}
    <div class="entry-body entry-body--project mb-12">
      {{ content | safe }}
    </div>

    {# Divider #}
    <div class="section-divider mb-6"></div>

    {# Footer: Filed Under + Prev/Next #}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-4">
      {# Filed Under #}
      {% if tags and tags.length %}
      <div class="flex items-center gap-2 flex-wrap" style="font-size: 14px;">
        <span class="text-ink-secondary">Filed under:</span>
        {% for tag in tags %}
          {% if tag !== "projects" %}
          <span class="chip">{{ tag }}</span>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}

      {# Prev / Next #}
      <div class="flex gap-3">
        {% set allProjects = collections.projects %}
        {% set currentIndex = -1 %}
        {% for item in allProjects %}
          {% if item.data.catalogId.id == catalogId.id %}
            {% set currentIndex = loop.index0 %}
          {% endif %}
        {% endfor %}

        {% if currentIndex > 0 %}
          {% set prevItem = allProjects[currentIndex - 1] %}
          <a href="/projects/{{ prevItem.data.catalogId.id | lower }}/" class="chip no-underline">← Previous</a>
        {% endif %}

        {% if currentIndex < allProjects.length - 1 %}
          {% set nextItem = allProjects[currentIndex + 1] %}
          <a href="/projects/{{ nextItem.data.catalogId.id | lower }}/" class="chip no-underline">Next →</a>
        {% endif %}
      </div>
    </div>

  </main>

  {% include "partials/footer.njk" %}

</body>
</html>
