<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ catalogId.id }} '{{ title }}' — Brewer Research & Design</title>
  <meta name="description" content="{{ title }}">
  {% include "partials/head-meta.njk" %}
  <link rel="stylesheet" href="/assets/css/main.css">
  <script>
    (function(){var d=document.documentElement,t=localStorage.getItem('theme');if(t==='dark'||(t!=='light'&&window.matchMedia('(prefers-color-scheme:dark)').matches)){d.classList.add('dark')}})();
  </script>
</head>
<body>

  {% include "partials/header.njk" %}

  <main class="container py-6" style="background-color: var(--color-bg);">

    {# Doc ID top-right #}
    <div class="flex justify-end mb-2">
      <span class="label-caps text-ink-secondary">Doc-ID: {{ catalogId.id }}-BX</span>
    </div>

    {# Breadcrumb #}
    <nav class="mb-6 label-caps" aria-label="Breadcrumb">
      <a href="/" class="text-ink-secondary no-underline hover:text-ink">Home</a>
      <span class="text-ink-secondary mx-1">/</span>
      <a href="/projects/" class="text-ink-secondary no-underline hover:text-ink">Projects</a>
      <span class="text-ink-secondary mx-1">/</span>
      <span class="text-ink font-bold">{{ catalogId.id }}</span>
    </nav>

    {# Title #}
    <div class="flex items-start gap-2 mb-4">
      <div class="w-1 bg-ink shrink-0 self-stretch"></div>
      <h1 class="headline-lg m-0">{{ catalogId.id }} '{{ title }}'</h1>
    </div>

    {# Metadata row #}
    <div class="flex flex-wrap gap-0 mb-4 border-rule inline-flex">
      <span class="label-caps px-3 py-1.5 border-r border-ink">{{ catalogId.id }}</span>
      <span class="label-caps px-3 py-1.5 border-r border-ink">{{ date_started | dateFormat }} → {{ date_updated | dateFormat }}</span>
      {% if status %}
      <span class="label-caps px-3 py-1.5
        {% if status === 'ongoing' %} text-accent-green
        {% elif status === 'abandoned' %} text-accent-rust
        {% elif status === 'dormant' %} text-ink-secondary
        {% endif %}
      ">Status: {{ status }}</span>
      {% endif %}
    </div>

    {# Links #}
    {% if links and links.length %}
    <div class="flex flex-wrap gap-2 mb-8">
      {% for link in links %}
      <a href="{{ link.url }}" class="chip no-underline hover-invert" target="_blank" rel="noopener">{{ link.label }} ↗</a>
      {% endfor %}
    </div>
    {% endif %}

    {# Entry body — project variant with dated log entries #}
    <div class="entry-body entry-body--project mb-12">
      {{ content | safe }}
    </div>

    {# Divider #}
    <div class="divider mb-6"></div>

    {# Footer: Filed Under + Prev/Next #}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      {# Filed Under #}
      {% if tags and tags.length %}
      <div class="flex items-center gap-2 flex-wrap">
        <span class="label-caps text-ink-secondary">Filed Under:</span>
        {% for tag in tags %}
          {% if tag !== "projects" %}
          <span class="label-caps text-accent-rust">{{ tag }}</span>
          {% if not loop.last %}<span class="text-ink-secondary">,</span>{% endif %}
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}

      {# Prev / Next #}
      <div class="flex gap-2">
        {% set allProjects = collections.projects %}
        {% set currentIndex = -1 %}
        {% for item in allProjects %}
          {% if item.data.catalogId.id == catalogId.id %}
            {% set currentIndex = loop.index0 %}
          {% endif %}
        {% endfor %}

        {% if currentIndex > 0 %}
          {% set prevItem = allProjects[currentIndex - 1] %}
          <a href="/projects/{{ prevItem.data.catalogId.id | lower }}/" class="chip no-underline hover-invert">‹ Prev Record</a>
        {% endif %}

        {% if currentIndex < allProjects.length - 1 %}
          {% set nextItem = allProjects[currentIndex + 1] %}
          <a href="/projects/{{ nextItem.data.catalogId.id | lower }}/" class="chip no-underline hover-invert">Next Record ›</a>
        {% endif %}
      </div>
    </div>

  </main>

  {% include "partials/footer.njk" %}

</body>
</html>
