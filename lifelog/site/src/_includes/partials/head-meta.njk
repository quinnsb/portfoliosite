{# Favicon #}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

{# OpenGraph #}
<meta property="og:title" content="{{ title | default('Brewer Research & Design') }}">
<meta property="og:description" content="{{ description | default('A personal archive of rankings, writing, and projects.') }}">
<meta property="og:type" content="{{ 'article' if catalogId else 'website' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="Brewer Research &amp; Design">

{# Twitter Card #}
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title | default('Brewer Research & Design') }}">
<meta name="twitter:description" content="{{ description | default('A personal archive of rankings, writing, and projects.') }}">

{# RSS discovery #}
<link rel="alternate" type="application/atom+xml" title="Brewer Research &amp; Design Feed" href="{{ site.url }}/feed.xml">

{# Canonical #}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

{# JSON-LD structured data #}
{% if catalogId %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "datePublished": "{{ (date or date_updated or date_started) | dateToRfc3339 }}",
  "author": {
    "@type": "Person",
    "name": "Quinn Brewer",
    "url": "https://quinnbrewer.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Brewer Research & Design",
    "url": "{{ site.url }}"
  },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
{% else %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Brewer Research & Design",
  "url": "{{ site.url }}",
  "description": "A personal archive of rankings, writing, and projects.",
  "author": {
    "@type": "Person",
    "name": "Quinn Brewer",
    "url": "https://quinnbrewer.com"
  }
}
</script>
{% endif %}
