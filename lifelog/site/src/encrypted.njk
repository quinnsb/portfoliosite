{# Classification warning #}
<section class="border-rule mb-6 p-5" style="background: repeating-linear-gradient(45deg, transparent, transparent 10px, var(--color-surface-container) 10px, var(--color-surface-container) 20px);">
  <div class="border-rule p-4 bg-bg">
    <p class="label-caps text-accent-rust text-center m-0 mb-2">⬛ TOP SECRET — INSTITUTIONAL USE ONLY ⬛</p>
    <p class="text-sm text-center m-0">
      This document has been encrypted pending review. Authorized personnel may attempt decryption using the console below. Adjust the cipher offset to decode the transmission.
    </p>
  </div>
</section>

{# Decryption console #}
<section class="border-rule mb-6">
  <div class="px-5 py-3 border-b border-ink flex items-center justify-between">
    <span class="label-caps">Decryption Console</span>
    <span class="label-caps text-ink-secondary" id="decrypt-status">Status: Locked</span>
  </div>
  <div class="p-5">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <label class="label-caps shrink-0" for="cipher-offset">Cipher Offset:</label>
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button class="chip hover-invert cursor-pointer" id="offset-down" aria-label="Decrease offset">−</button>
        <div class="border-rule px-4 py-2 text-center min-w-[60px]">
          <span class="text-lg font-bold" id="offset-display">00</span>
        </div>
        <button class="chip hover-invert cursor-pointer" id="offset-up" aria-label="Increase offset">+</button>
        <input
          type="range"
          id="cipher-offset"
          min="0"
          max="25"
          value="0"
          class="flex-1 sm:w-48"
          aria-label="Cipher offset value"
        >
      </div>
    </div>
    <div class="divider-dashed my-4"></div>
    <p class="label-caps text-ink-secondary m-0">Hint: The correct offset will produce readable English text. There are 26 possible positions.</p>
  </div>
</section>

{# Encrypted document body #}
<section class="border-rule mb-6">
  <div class="px-5 py-3 border-b border-ink flex items-center justify-between">
    <span class="label-caps">Document Content</span>
    <span class="label-caps text-ink-secondary">Ref: BRD-2026-CLASSIFIED</span>
  </div>

  <div class="p-5" id="cipher-body">
    <div class="mb-6">
      <p class="label-caps text-accent-rust mb-3">Memorandum — Internal Use Only</p>
      <p class="label-caps text-ink-secondary mb-4">From: The Director &nbsp;|&nbsp; To: All Personnel &nbsp;|&nbsp; Re: Institutional Purpose</p>
    </div>

    <div class="cipher-text text-sm leading-relaxed" style="word-break: break-word;">
      <p class="mb-4" data-plain="After considerable review of this institution's operational history, it has come to my attention that we have never formally documented our reason for existing. This is an oversight that borders on institutional malpractice.">
      </p>
      <p class="mb-4" data-plain="Let the record show: Brewer Research and Design was established for the sole purpose of applying an unreasonable level of seriousness to topics that do not warrant it. We rank things. We write about things. We build things. None of these things needed to be done.">
      </p>
      <p class="mb-4" data-plain="Our methodology is simple. Take a subject of absolutely no consequence. Treat it as though the future of Western civilization depends on our analysis. Publish the results to an audience that did not ask for them and will not read them.">
      </p>
      <p class="mb-4" data-plain="Some have questioned whether this constitutes a productive use of time. To those individuals I say: you are almost certainly correct. But productivity was never the objective. The objective was always to make something where nothing was required.">
      </p>
      <p class="mb-4" data-plain="If you are reading this, you have either solved the cipher or you are one of those people who reads the page source. Either way, welcome. You are exactly the kind of person this archive was built for.">
      </p>
      <p class="mb-0 label-caps" data-plain="Classification: Downgraded to public. Distribution: Unlimited. Status: Permanently amused.">
      </p>
    </div>
  </div>
</section>

{# Decoded stamp — hidden until solved #}
<div id="decoded-stamp" class="hidden">
  <section class="border-rule mb-6 p-5 text-center">
    <p class="label-caps text-accent-blue mb-2">⬛ Document Successfully Decrypted ⬛</p>
    <p class="label-caps text-ink-secondary m-0">Clearance Granted · Welcome to the Archive</p>
  </section>
</div>

<div class="text-center label-caps text-ink-secondary py-4">
  — End of encrypted document —
</div>

<script>
(function () {
  var SHIFT = 17;
  var offset = 0;
  var display = document.getElementById('offset-display');
  var slider = document.getElementById('cipher-offset');
  var status = document.getElementById('decrypt-status');
  var stamp = document.getElementById('decoded-stamp');
  var paras = document.querySelectorAll('.cipher-text [data-plain]');

  function caesarShift(text, n) {
    var result = '';
    for (var i = 0; i < text.length; i++) {
      var c = text.charCodeAt(i);
      if (c >= 65 && c <= 90) {
        result += String.fromCharCode(((c - 65 + n) % 26) + 65);
      } else if (c >= 97 && c <= 122) {
        result += String.fromCharCode(((c - 97 + n) % 26) + 97);
      } else {
        result += text[i];
      }
    }
    return result;
  }

  function render() {
    var decoded = offset === SHIFT;
    for (var i = 0; i < paras.length; i++) {
      var plain = paras[i].getAttribute('data-plain');
      var encrypted = caesarShift(plain, (26 - SHIFT + offset) % 26);
      paras[i].textContent = decoded ? plain : encrypted;
    }

    display.textContent = offset < 10 ? '0' + offset : '' + offset;
    slider.value = offset;

    if (decoded) {
      status.textContent = 'Status: Decrypted';
      status.className = 'label-caps text-accent-blue';
      stamp.classList.remove('hidden');
      document.querySelector('.cipher-text').style.fontStyle = 'normal';
    } else {
      status.textContent = 'Status: Locked';
      status.className = 'label-caps text-ink-secondary';
      stamp.classList.add('hidden');
    }
  }

  for (var i = 0; i < paras.length; i++) {
    paras[i].textContent = caesarShift(paras[i].getAttribute('data-plain'), (26 - SHIFT) % 26);
  }

  slider.addEventListener('input', function () {
    offset = parseInt(this.value, 10);
    render();
  });

  document.getElementById('offset-up').addEventListener('click', function () {
    offset = (offset + 1) % 26;
    render();
  });

  document.getElementById('offset-down').addEventListener('click', function () {
    offset = (offset + 25) % 26;
    render();
  });
})();
</script>
