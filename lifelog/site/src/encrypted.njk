---
layout: base.njk
title: "Encrypted — Brewer Research & Design"
description: "Classified document. Decryption required."
permalink: "encrypted/"
---

{# Page header #}
<section class="py-10">
  <h1 class="hero-headline" style="font-size: clamp(36px, 6vw, 72px); margin-bottom: 12px;">Encrypted</h1>
  <p class="hero-subtitle" style="margin-bottom: 0;">Classified document. Decryption required.</p>
</section>

<div class="section-divider"></div>

{# Classification notice #}
<div style="background: var(--color-surface-container); border-radius: 8px; padding: 24px; margin: 32px 0; text-align: center;">
  <p style="font-size: 14px; font-weight: 700; color: var(--color-accent-rust); margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.04em;">Top Secret — Institutional Use Only</p>
  <p style="font-size: 16px; color: var(--color-ink-secondary); margin: 0; line-height: 1.6;">
    This document has been encrypted pending review. Adjust the cipher offset below to decode the transmission.
  </p>
</div>

{# Decryption console #}
<section style="border: 1px solid var(--color-border); border-radius: 8px; margin-bottom: 32px; overflow: hidden;">
  <div style="padding: 16px 24px; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
    <span style="font-size: 14px; font-weight: 700;">Decryption Console</span>
    <span style="font-size: 13px; color: var(--color-ink-secondary);" id="decrypt-status">Status: Locked</span>
  </div>
  <div style="padding: 24px;">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <label class="shrink-0" for="cipher-offset" style="font-size: 14px; font-weight: 700;">Cipher Offset:</label>
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button class="chip cursor-pointer" id="offset-down" aria-label="Decrease offset">−</button>
        <div style="border: 1px solid var(--color-border); border-radius: 8px; padding: 8px 16px; text-align: center; min-width: 60px;">
          <span style="font-size: 20px; font-weight: 700;" id="offset-display">00</span>
        </div>
        <button class="chip cursor-pointer" id="offset-up" aria-label="Increase offset">+</button>
        <input
          type="range"
          id="cipher-offset"
          min="0"
          max="25"
          value="0"
          class="flex-1 sm:w-48"
          aria-label="Cipher offset value"
        >
      </div>
    </div>
    <div class="section-divider" style="margin: 20px 0;"></div>
    <p style="font-size: 14px; color: var(--color-ink-secondary); margin: 0;">Hint: The correct offset will produce readable English text. There are 26 possible positions.</p>
  </div>
</section>

{# Encrypted document body #}
<section style="border: 1px solid var(--color-border); border-radius: 8px; margin-bottom: 32px; overflow: hidden;">
  <div style="padding: 16px 24px; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
    <span style="font-size: 14px; font-weight: 700;">Document Content</span>
  </div>

  <div style="padding: 24px;" id="cipher-body">
    <div style="margin-bottom: 24px;">
      <p style="font-size: 14px; font-weight: 700; color: var(--color-accent-rust); margin: 0 0 8px;">Memorandum — Internal Use Only</p>
      <p style="font-size: 13px; color: var(--color-ink-secondary); margin: 0;">From: The Director · To: All Personnel · Re: Institutional Purpose</p>
    </div>

    <div class="cipher-text" style="font-size: 16px; line-height: 1.7; word-break: break-word;">
      <p class="mb-4" data-plain="After considerable review of this institution's operational history, it has come to my attention that we have never formally documented our reason for existing. This is an oversight that borders on institutional malpractice.">
      </p>
      <p class="mb-4" data-plain="Let the record show: Brewer Research and Design was established for the sole purpose of applying an unreasonable level of seriousness to topics that do not warrant it. We rank things. We write about things. We build things. None of these things needed to be done.">
      </p>
      <p class="mb-4" data-plain="Our methodology is simple. Take a subject of absolutely no consequence. Treat it as though the future of Western civilization depends on our analysis. Publish the results to an audience that did not ask for them and will not read them.">
      </p>
      <p class="mb-4" data-plain="Some have questioned whether this constitutes a productive use of time. To those individuals I say: you are almost certainly correct. But productivity was never the objective. The objective was always to make something where nothing was required.">
      </p>
      <p class="mb-4" data-plain="If you are reading this, you have either solved the cipher or you are one of those people who reads the page source. Either way, welcome. You are exactly the kind of person this archive was built for.">
      </p>
      <p class="mb-0" data-plain="Classification: Downgraded to public. Distribution: Unlimited. Status: Permanently amused." style="font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.02em;">
      </p>
    </div>
  </div>
</section>

{# Decoded stamp — hidden until solved #}
<div id="decoded-stamp" class="hidden">
  <div style="background: var(--color-surface-container); border-radius: 8px; padding: 24px; margin-bottom: 32px; text-align: center;">
    <p style="font-size: 14px; font-weight: 700; color: var(--color-accent-blue); margin: 0 0 4px;">Document Successfully Decrypted</p>
    <p style="font-size: 13px; color: var(--color-ink-secondary); margin: 0;">Clearance Granted · Welcome to the Archive</p>
  </div>
</div>

<p class="text-center text-ink-secondary py-4" style="font-size: 14px;">
  End of encrypted document.
</p>

<script>
(function () {
  var SHIFT = 17;
  var offset = 0;
  var display = document.getElementById('offset-display');
  var slider = document.getElementById('cipher-offset');
  var status = document.getElementById('decrypt-status');
  var stamp = document.getElementById('decoded-stamp');
  var paras = document.querySelectorAll('.cipher-text [data-plain]');

  function caesarShift(text, n) {
    var result = '';
    for (var i = 0; i < text.length; i++) {
      var c = text.charCodeAt(i);
      if (c >= 65 && c <= 90) {
        result += String.fromCharCode(((c - 65 + n) % 26) + 65);
      } else if (c >= 97 && c <= 122) {
        result += String.fromCharCode(((c - 97 + n) % 26) + 97);
      } else {
        result += text[i];
      }
    }
    return result;
  }

  function render() {
    var decoded = offset === SHIFT;
    for (var i = 0; i < paras.length; i++) {
      var plain = paras[i].getAttribute('data-plain');
      var encrypted = caesarShift(plain, (26 - SHIFT + offset) % 26);
      paras[i].textContent = decoded ? plain : encrypted;
    }

    display.textContent = offset < 10 ? '0' + offset : '' + offset;
    slider.value = offset;

    if (decoded) {
      status.textContent = 'Status: Decrypted';
      status.style.color = 'var(--color-accent-blue)';
      stamp.classList.remove('hidden');
    } else {
      status.textContent = 'Status: Locked';
      status.style.color = 'var(--color-ink-secondary)';
      stamp.classList.add('hidden');
    }
  }

  for (var i = 0; i < paras.length; i++) {
    paras[i].textContent = caesarShift(paras[i].getAttribute('data-plain'), (26 - SHIFT) % 26);
  }

  slider.addEventListener('input', function () {
    offset = parseInt(this.value, 10);
    render();
  });

  document.getElementById('offset-up').addEventListener('click', function () {
    offset = (offset + 1) % 26;
    render();
  });

  document.getElementById('offset-down').addEventListener('click', function () {
    offset = (offset + 25) % 26;
    render();
  });
})();
</script>
