{
  "name": "brewer-research-design",
  "version": "1.0.0",
  "description": "Brewer Research & Design — personal archive",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i src/assets/css/main.css -o _site/assets/css/main.css --minify",
    "watch:css": "npx @tailwindcss/cli -i src/assets/css/main.css -o _site/assets/css/main.css --watch",
    "build:11ty": "npx @11ty/eleventy",
    "watch:11ty": "npx @11ty/eleventy --serve",
    "build": "npm run build:css && npm run build:11ty",
    "dev": "npx @11ty/eleventy --serve & npm run watch:css"
  },
  "keywords": [],
  "author": "Quinn Brewer",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@tailwindcss/cli": "^4.2.4",
    "tailwindcss": "^4.2.4"
  }
}
